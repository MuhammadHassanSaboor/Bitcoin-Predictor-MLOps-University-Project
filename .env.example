# Copy this file to .env and change the values. .env is git-ignored: never commit it.

# Docker Hub username used to name local images (e.g. yourname/btc-forecast-api)
DOCKER_USERNAME=local

# Key required in the X-API-Key header for POST /reload (Airflow sends it)
API_KEY=change-me

LOG_LEVEL=INFO

# Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-too

# Postgres used by Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
